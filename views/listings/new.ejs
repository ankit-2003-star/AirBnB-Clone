<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <h3>Add New Listing</h3>
    <form action="/listings" method="post">
        <!-- <label for="title">Title</label> -->
        <input type="text" name="title" id="title" placeholder="Enter Title">
        <br><br>
        <!-- <label for="description">Description</label> -->
        <textarea type="text" name="description" id="description" placeholder="Enter Description"></textarea>
        <br><br>
        <!-- <label for="image">Image</label> -->
        <input type="text" name="image" id="image" placeholder="Enter image URL">
        <br><br>
        <!-- <label for="price">Price</label> -->
        <input type="number" name="price" id="price" placeholder="Enter Price">
        <br><br>
        <!-- <label for="location">Location</label> -->
        <input type="text" name="location" id="location" placeholder="Enter Location">
        <br><br>
        <!-- <label for="country">Country</label> -->
        <input type="text" name="country" id="country" placeholder="Enter Country">
        <br><br>
        <button type="submit">Add</button>
    </form>
</body>
</html>